
void setup(){
  size(500, 500);
}
void draw(){
  strokeWeight(10);
  stroke(0,0,0);
  fill(0, 255, 255);
  triangle(200, 300, 300, 300, 250, 30);
  fill(255, 0, 0);
  ellipse(250, 250, 200, 300);
  fill(255, 255, 255);
  ellipse(200, 200, 50, 50);
  ellipse(300, 200, 50, 50);
  fill(255, 100, 100);
  ellipse(250, 250, 95, 95);
  fill(0, 0, 0);
  ellipse(190, 210, 25, 25);
  ellipse(310, 190, 25, 25);
  fill(255, 255, 255);
  arc(250, 300, 100, 100, 0, PI, PIE);
  noFill();
  curve(250, 250, 325, 350, 400, 350, 500, 600);
  curve(250, 250, 175, 350, 100, 350, 0, 600);
  curve(250, 250, 300, 380, 370, 400, 500, 600);
  curve(250, 250, 200, 380, 130, 400, 0, 600);
}

